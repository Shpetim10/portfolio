{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm serve",
      "startServerReadyPattern": "ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/work/example-project-01/",
        "http://localhost:3100/resume/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertions": {
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/reports"
    }
  }
}
